<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Palette -->
    <Color x:Key="BgColor">#F8FAFC</Color>
    <Color x:Key="BgSecondaryColor">#FFFFFF</Color>
    <Color x:Key="BgCardColor">#FFFFFF</Color>
    <Color x:Key="BgCardHoverColor">#F1F5F9</Color>
    <Color x:Key="SidebarBgColor">#F1F5F9</Color>
    <Color x:Key="SidebarItemHoverColor">#E2E8F0</Color>
    <Color x:Key="SidebarItemSelectedColor">#3B82F6</Color>

    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderLightColor">#CBD5E1</Color>

    <Color x:Key="AccentColor">#2563EB</Color>
    <Color x:Key="AccentHoverColor">#1D4ED8</Color>
    <Color x:Key="AccentGlowColor">#93C5FD</Color>

    <Color x:Key="SuccessColor">#059669</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="WarningColor">#D97706</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="BgSecondaryBrush" Color="{StaticResource BgSecondaryColor}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}"/>
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="{StaticResource BgCardHoverColor}"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="SidebarItemSelectedBrush" Color="{StaticResource SidebarItemSelectedColor}"/>

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}"/>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

</ResourceDictionary>
